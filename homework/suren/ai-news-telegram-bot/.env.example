# Copy this file to .env and fill in your values. .env is git-ignored.
# Never commit .env or paste the token into code, issues, logs or chat.

# From @BotFather (see README: "Create the Telegram bot")
TELEGRAM_BOT_TOKEN=<your-bot-token>
# From `python -m notifier.get_chat_id` (see README: "Find your chat ID")
TELEGRAM_CHAT_ID=<your-chat-id>

# Optional digest settings (defaults shown)
# DIGEST_WINDOW_HOURS=24
# DIGEST_MAX_STORIES=5
# RSS_FEEDS=Name | https://example.com/feed.xml; Other | https://example.org/rss
