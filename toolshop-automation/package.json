{
  "name": "toolshop-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for https://practicesoftwaretesting.com/ (the Toolshop practice app).",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report report",
    "review": "bash scripts/claude-hooks/review-diff.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "dotenv": "^16.4.7"
  }
}
